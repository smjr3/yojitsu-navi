{
  "name": "yojitsu-navi",
  "version": "0.2.1",
  "description": "予実ナビ（保守案件の予算と実績のダッシュボード）一式を作るコマンドと、計算コア（予算・実績・残予算・着地見込みの計算と型）",
  "license": "MIT",
  "keywords": [
    "予実",
    "budget",
    "forecast",
    "dashboard",
    "gitlab-pages"
  ],
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    }
  },
  "bin": {
    "yojitsu-navi": "bin/yojitsu-navi.mjs"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "template",
    "sample",
    "deps",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  }
}
