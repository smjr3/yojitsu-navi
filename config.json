{
  "fiscalYearStartMonth": 4,
  "standardHoursPerMonth": 160,
  "hoursPerBusinessDay": 8,
  "burnRateDangerThreshold": 1.0,
  "closingBusinessDay": 3,
  "forecastMethodDefault": "assignment",
  "forecastRecentMonths": 3,
  "currency": { "code": "JPY", "defaultUnit": "millionYen" },
  "labels": {
    "customer": "顧客",
    "project": "案件",
    "contract": "契約",
    "team": "チーム",
    "member": "メンバー"
  },
  "worklogSource": {
    "adapter": "csv",
    "csv": { "path": "data/worklogs" },
    "http": {
      "url": "",
      "authHeader": "Authorization",
      "refetchMonths": 3,
      "columns": {
        "date": "date",
        "memberId": "member_id",
        "memberName": "member_name",
        "customerName": "customer_name",
        "projectName": "project_name",
        "task": "task",
        "hours": "hours"
      }
    }
  },
  "memberSource": {
    "adapter": "none",
    "csv": { "path": "data/hr/members.csv" },
    "columns": {
      "memberId": "member_id",
      "name": "name",
      "kind": "kind",
      "title": "title"
    }
  },
  "projectSource": {
    "adapter": "none",
    "http": {
      "url": "",
      "authHeader": "Authorization"
    },
    "columns": {
      "projectId": "project_id",
      "customerName": "customer_name",
      "projectName": "project_name"
    },
    "filters": []
  },
  "taskCodeCheck": {
    "include": ["_保守対応"],
    "exclude": [],
    "onUnregistered": "warn",
    "onChange": "warn"
  },
  "projectFromTask": {
    "marker": "_保守対応",
    "enabled": false
  },
  "costTypes": [
    { "id": "labor", "label": "工数" }
  ],
  "masterEdit": {
    "mode": "gitlab",
    "gitlab": {
      "apiBaseUrl": "",
      "projectId": "",
      "targetBranch": "main",
      "commitMode": "mr",
      "tokenUrl": ""
    }
  }
}
