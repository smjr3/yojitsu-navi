{
  "name": "yojitsu-navi",
  "version": "0.2.0",
  "private": true,
  "description": "保守契約の予実（予算と実績）管理ダッシュボード",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/seed-npm-cache.mjs",
    "dev": "tsx scripts/dev.ts",
    "prebuild": "node scripts/seed-npm-cache.mjs",
    "build": "tsx scripts/build.ts",
    "clean": "observable clean",
    "fetch": "tsx scripts/fetch-worklogs.ts",
    "fetch:members": "tsx scripts/fetch-members.ts",
    "validate": "tsx scripts/validate-data.ts",
    "gitlab:setup": "tsx scripts/gitlab-setup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c tests/e2e/playwright.config.ts --grep @smoke",
    "check": "npm run typecheck && npm run validate && npm run test",
    "verify:dist": "tsx scripts/verify-dist.ts",
    "app:build": "node scripts/build-app.mjs",
    "app:pack": "node scripts/build-app.mjs --pack"
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.4",
    "@observablehq/inputs": "^0.12.0",
    "@observablehq/plot": "^0.6.17",
    "d3": "^7.9.0",
    "d3-dsv": "^3.0.1",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5",
    "htl": "^0.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
